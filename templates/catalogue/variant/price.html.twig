{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    {% if form is null %}
        <p class="empty">Aucune saison courante. Définissez une saison courante pour saisir les tarifs.</p>
        <div class="actions"><a class="btn" href="{{ cancel_url }}">Retour</a></div>
    {% else %}
        <p>Saison {{ season.label }}</p>
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {% for name in ['clubPriceTtc', 'publicPriceTtc'] %}
                <div class="field">
                    {{ form_label(form[name]) }}
                    {{ form_widget(form[name]) }}
                    {% for error in form[name].vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
                </div>
            {% endfor %}

            {% for error in form.vars.errors %}<p class="form-error">{{ error.message }}</p>{% endfor %}

            <div class="actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn" href="{{ cancel_url }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}
