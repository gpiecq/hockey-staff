{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
        {% for name in ['name', 'parent'] %}
            <div class="field">
                {{ form_label(form[name]) }}
                {{ form_widget(form[name]) }}
                {% if form[name].vars.help %}<p class="help">{{ form[name].vars.help }}</p>{% endif %}
                {% for error in form[name].vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
            </div>
        {% endfor %}

        {% for error in form.vars.errors %}<p class="form-error">{{ error.message }}</p>{% endfor %}

        <div class="actions">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn" href="{{ path('catalogue_category_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
