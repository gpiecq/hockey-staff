{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
        {% for name in ['supplier', 'reference', 'designation', 'brand', 'category'] %}
            <div class="field">
                {{ form_label(form[name]) }}
                {{ form_widget(form[name]) }}
                {% for error in form[name].vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
            </div>
        {% endfor %}

        <fieldset class="field">
            <legend>Mode de suivi</legend>
            <div class="tiles">
                {% for choice in form.trackingMode %}
                    <label class="tile">{{ form_widget(choice) }}<span>{{ choice.vars.label }}</span></label>
                {% endfor %}
            </div>
            {% if form.vars.value.id is null %}<p class="help">Laisser vide pour appliquer le mode par défaut de la catégorie.</p>{% endif %}
            {% for error in form.trackingMode.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
        </fieldset>

        {% for error in form.vars.errors %}<p class="form-error">{{ error.message }}</p>{% endfor %}

        <div class="actions">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn" href="{{ cancel_url }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
