{% extends 'base.html.twig' %}

{% block title %}{{ product.designation }}{% endblock %}

{% block body %}
    <a class="back" href="{{ path('catalogue_product_index') }}">‹ Produits</a>
    <div class="page-head">
        <h1>{{ product.designation }}</h1>
        {% if is_granted('CATALOGUE_EDIT') %}
            <span class="actions">
                {% if is_granted('ROLE_MANAGER') %}<a class="btn" href="{{ path('catalogue_product_price', {id: product.id}) }}">Tarif produit</a>{% endif %}
                <a class="btn" href="{{ path('catalogue_product_edit', {id: product.id}) }}">Modifier</a>
                <a class="btn" href="{{ path('catalogue_product_delete', {id: product.id}) }}">Supprimer</a>
            </span>
        {% endif %}
    </div>

    <dl class="product-meta">
        <dt>Référence</dt><dd>{{ product.reference }}</dd>
        <dt>Fournisseur</dt><dd>{{ product.supplier.name }}</dd>
        <dt>Marque</dt><dd>{{ product.brand ? product.brand.name : '—' }}</dd>
        <dt>Catégorie</dt><dd>{{ product.category ? product.category.path : 'Sans catégorie' }}</dd>
        <dt>Type</dt><dd>{{ product.kind.label }}</dd>
    </dl>

    <h2>Variantes{% if season %} · tarifs {{ season.label }}{% endif %}</h2>
    {% if variants is empty %}
        <p class="empty">Aucune variante.</p>
    {% else %}
        {% set printable = is_granted('STOCK_MOVE') %}
        {% if printable %}<form method="get" action="{{ path('label_print') }}" data-turbo-frame="_top">{% endif %}
        <table class="table">
            <thead>
                <tr><th>Variante</th><th>EAN</th><th class="num">Prix club TTC</th><th class="num">Prix club HT</th><th class="num">Prix public TTC</th><th class="num">Stock</th>{% if is_granted('CATALOGUE_EDIT') %}<th></th>{% endif %}</tr>
            </thead>
            <tbody>
                {% for variant in variants %}
                    {% set price = prices[variant.id]|default(null) %}
                    <tr>
                        <td>
                            {% if printable %}<input type="checkbox" name="variantes[]" value="{{ variant.id }}" checked aria-label="Imprimer une étiquette pour {{ variant.label ?: 'Unique' }}">{% endif %}
                            {% if is_granted('STOCK_VIEW') %}<a href="{{ path('stock_variant_show', {id: variant.id}) }}"><strong>{{ variant.label ?: 'Unique' }}</strong></a>{% else %}<strong>{{ variant.label ?: 'Unique' }}</strong>{% endif %}
                            {% if variant.archived %}<span class="badge badge-warn">Archivée</span>{% elseif not variant.active %}<span class="badge badge-warn">Plus au catalogue</span>{% endif %}
                            <small class="muted block">{{ variant.code }}</small>
                        </td>
                        <td data-label="EAN">{{ variant.ean ?? '—' }}</td>
                        {% if price %}
                            <td class="num" data-label="Prix club TTC">{{ price.clubPriceTtc is null ? '—' : price.clubPriceTtc|euros }}</td>
                            <td class="num" data-label="Prix club HT">{{ price.clubPriceHt is null ? '—' : price.clubPriceHt|euros }}</td>
                            <td class="num" data-label="Prix public TTC">{{ price.publicPriceTtc is null ? '—' : price.publicPriceTtc|euros }}</td>
                        {% else %}
                            <td colspan="3" class="muted">Tarif absent</td>
                        {% endif %}
                        {% set vstock = stock[variant.id]|default({levels: [], items: [], loaned: [], held: 0}) %}
                        {% set lent = vstock.loaned|length + vstock.held %}
                        {% set qty = vstock.items|length + lent %}
                        {% for level in vstock.levels %}{% set qty = qty + level.quantity %}{% endfor %}
                        <td class="num" data-label="Stock">
                            <strong>{{ qty }}</strong>
                            {% if qty > 0 %}
                                <small class="muted">
                                    {% for level in vstock.levels %}{{ level.location.name }} : {{ level.quantity }}{% if not loop.last or vstock.items is not empty %} · {% endif %}{% endfor %}
                                    {% set byLocation = {} %}
                                    {% for item in vstock.items %}{% set byLocation = byLocation|merge({(item.location.name): (byLocation[item.location.name]|default(0)) + 1}) %}{% endfor %}
                                    {% for name, n in byLocation %}{{ name }} : {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}
                                </small>
                            {% endif %}
                            {% if lent > 0 %}<small class="muted block">dont {{ lent }} prêtée{{ lent > 1 ? 's' : '' }}</small>{% endif %}
                            <small><a href="{{ path('stock_operation_index', {variante: variant.id}) }}">Historique</a></small>
                        </td>
                        {% if is_granted('CATALOGUE_EDIT') %}
                            <td>
                                <a href="{{ path('catalogue_variant_edit', {id: variant.id}) }}">Modifier</a>
                                <a href="{{ path('catalogue_variant_price', {id: variant.id}) }}">Tarif</a>
                                <a href="{{ path('catalogue_variant_delete', {id: variant.id}) }}">Supprimer</a>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        {% if printable %}
            <p><button type="submit" class="btn">Imprimer des étiquettes</button></p>
            </form>
        {% endif %}
    {% endif %}

    {% if is_granted('CATALOGUE_EDIT') %}
        <p><a class="btn btn-primary" href="{{ path('catalogue_variant_new', {id: product.id}) }}">Nouvelle variante</a></p>
    {% endif %}
{% endblock %}
