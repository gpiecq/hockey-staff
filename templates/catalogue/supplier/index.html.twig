{% extends 'base.html.twig' %}

{% block title %}Fournisseurs{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Fournisseurs</h1>
        {% if is_granted('CATALOGUE_EDIT') %}<a class="btn btn-primary" href="{{ path('catalogue_supplier_new') }}">Nouveau fournisseur</a>{% endif %}
    </div>

    {% if page.items is empty %}
        <p class="empty">Aucun fournisseur.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr><th>Nom</th><th></th></tr>
            </thead>
            <tbody>
                {% for supplier in page.items %}
                    <tr>
                        <td>{{ supplier.name }}</td>
                        <td>
                            {% if is_granted('CATALOGUE_EDIT') %}
                                <a href="{{ path('catalogue_supplier_edit', {id: supplier.id}) }}">Modifier</a>
                                <a href="{{ path('catalogue_supplier_delete', {id: supplier.id}) }}">Supprimer</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% include '_pagination.html.twig' with {page: page, noun: 'fournisseurs'} %}
{% endblock %}
