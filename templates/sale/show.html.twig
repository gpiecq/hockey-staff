{% extends 'base.html.twig' %}

{% block title %}Vente n° {{ sale.id }}{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Vente n° {{ sale.id }}</h1>
        <span class="actions">
            <a class="btn" href="{{ path('stock_operation_show', {id: sale.operation.id}) }}">Opération de stock</a>
            <a class="btn" href="{{ path('sale_index') }}">Toutes les ventes</a>
        </span>
    </div>

    <dl class="product-meta">
        <dt>Date</dt><dd>{{ sale.operation.occurredAt|date('d/m/Y H:i') }}</dd>
        <dt>Acheteur</dt><dd>{{ sale.buyer }}</dd>
        {% if sale.player %}<dt>Joueur</dt><dd>{{ include('player/_link.html.twig', {player: sale.player}) }}</dd>{% endif %}
        {% if sale.comment %}<dt>Commentaire</dt><dd>{{ sale.comment }}</dd>{% endif %}
    </dl>

    <table class="table">
        <thead>
            <tr><th>Article</th><th>État</th><th class="num">Quantité</th><th class="num">Prix public</th><th class="num">Réduction</th><th class="num">Prix unitaire TTC</th><th class="num">Prix unitaire HT</th><th class="num">Total TTC</th></tr>
        </thead>
        <tbody>
            {% for line in sale.lines %}
                {% set variant = line.variant %}
                <tr>
                    <td data-label="Article">
                        <a href="{{ path('stock_variant_show', {id: variant.id}) }}">{{ variant.product.reference }} — {{ variant.product.designation }} · {{ variant.label ?: 'Unique' }}</a>
                    </td>
                    <td data-label="État">{{ line.condition.label }}</td>
                    <td class="num" data-label="Quantité">{{ line.quantity }}</td>
                    <td class="num" data-label="Prix public">{{ line.basePriceTtc is null ? '—' : line.basePriceTtc|euros }}</td>
                    <td class="num" data-label="Réduction">{{ line.discountRate is null ? '—' : (line.discountRate / 100)|number_format(0) ~ ' %' ~ (line.discountApplied ? '' : ' (non appliquée)') }}</td>
                    <td class="num" data-label="Prix unitaire TTC">{{ line.priceTtc|euros }}</td>
                    <td class="num" data-label="Prix unitaire HT">{{ line.priceHt|euros }}</td>
                    <td class="num" data-label="Total TTC">{{ line.totalTtc|euros }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr><th colspan="7">Total ({{ sale.totalHt|euros }} HT)</th><th class="num">{{ sale.totalTtc|euros }}</th></tr>
        </tfoot>
    </table>
{% endblock %}
