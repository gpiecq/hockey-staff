<div class="entry-line" data-form-collection-item>
    <div class="field">
        {{ form_label(line.stock) }}
        {{ form_widget(line.stock) }}
        {{ form_help(line.stock) }}
        {% for error in line.stock.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
    </div>
    <div class="field">
        {{ form_label(line.quantity) }}
        {{ form_widget(line.quantity) }}
        {% for error in line.quantity.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
    </div>
    <div class="field">
        {{ form_label(line.discount) }}
        {{ form_widget(line.discount) }}
        {% for error in line.discount.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
    </div>
    <div class="field sale-final-price">
        {{ form_label(line.finalPrice) }}
        {{ form_widget(line.finalPrice) }}
        {{ form_help(line.finalPrice) }}
        {% for error in line.finalPrice.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
    </div>
    {% if preview %}
        <p class="sale-line-preview">
            Prix public : {{ preview.basePriceTtc is null ? '—' : preview.basePriceTtc|euros }}
            {% if preview.error %}
                <br><span class="field-error">{{ preview.error }}</span>
            {% elseif preview.price %}
                {% set price = preview.price %}
                {% if price.discountRate is not null %} · Réduction : {{ (price.discountRate / 100)|number_format(0) }} %{% if not price.discountApplied %} (non appliquée){% endif %}{% endif %}
                · Prix TTC : {{ price.priceTtc|euros }} · Prix HT : {{ price.priceHt|euros }}
                <br>Total ligne : {{ preview.totalTtc|euros }} TTC ({{ preview.quantity }} × {{ price.priceTtc|euros }})
            {% endif %}
        </p>
    {% endif %}
    <button type="button" class="btn" data-action="form-collection#remove">Retirer la ligne</button>
</div>
