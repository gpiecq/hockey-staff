{% extends 'base.html.twig' %}

{% block title %}Imports{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Imports</h1>
        <a class="btn btn-primary" href="{{ path('import_new') }}">Nouvel import</a>
    </div>

    {% if page.items is empty %}
        <p class="empty">Aucun import pour le moment.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr><th>Date</th><th>Fournisseur</th><th>Saison</th><th>Fichier</th><th>Statut</th><th></th></tr>
            </thead>
            <tbody>
                {% for run in page.items %}
                    <tr>
                        <td data-label="Date">{{ run.createdAt ? run.createdAt|date('d/m/Y H:i') : '—' }}</td>
                        <td data-label="Fournisseur">{{ run.supplier.name }}</td>
                        <td data-label="Saison">{{ run.season.label }}</td>
                        <td data-label="Fichier">{{ run.originalFilename }}</td>
                        <td data-label="Statut"><span class="badge{{ run.status.value in ['applied', 'analyzed'] ? ' badge-strong' : (run.status.value == 'failed' ? ' badge-warn' : '') }}">{{ run.status.label }}</span></td>
                        <td><a href="{{ path('import_show', {id: run.id}) }}">Voir</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% include '_pagination.html.twig' with {page: page, noun: 'imports'} %}
{% endblock %}
