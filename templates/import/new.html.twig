{% extends 'base.html.twig' %}

{% block title %}Nouvel import{% endblock %}

{% block body %}
    <a class="back" href="{{ path('import_index') }}">‹ Imports</a>
    <h1>Nouvel import</h1>
    <p class="lead">Déposez le catalogue d'un fournisseur : il est analysé, puis vous validez les changements avant de les appliquer.</p>

    {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate', 'data-turbo': 'false'}}) }}
        {% for name in ['supplier', 'season', 'file'] %}
            <div class="field">
                {{ form_label(form[name]) }}
                {{ form_widget(form[name]) }}
                {% if form[name].vars.help %}<p class="help">{{ form[name].vars.help }}</p>{% endif %}
                {% for error in form[name].vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
            </div>
        {% endfor %}

        {% for error in form.vars.errors %}<p class="form-error">{{ error.message }}</p>{% endfor %}

        <div class="actions">
            <button type="submit" class="btn btn-primary">Analyser le fichier</button>
            <a class="btn" href="{{ path('import_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
