{% extends 'base.html.twig' %}

{% block title %}Scanner{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Scanner</h1>
    </div>

    <p>Scannez l'étiquette ou saisissez le code (EAN ou HV-…).</p>

    {% if unknown %}
        <div class="flash flash-error" role="alert">Code inconnu : {{ code }}</div>
    {% endif %}

    <form method="get" action="{{ path('scan_index') }}" data-scan-form data-controller="scanner bridge--barcode-scanner">
        <label for="scan-code">Code</label>
        <input type="text" name="code" id="scan-code" value="{{ code }}" autofocus autocomplete="off" data-scanner-target="input" data-bridge--barcode-scanner-target="input">
        <button type="submit" class="btn">Ouvrir</button>
        <div data-scan-zone class="scan-zone">
            <button type="button" class="btn" data-scanner-target="webButton" data-bridge--barcode-scanner-target="webButton" data-action="scanner#start">Scanner avec la caméra</button>
            <button type="button" class="btn" data-bridge--barcode-scanner-target="nativeButton" data-action="bridge--barcode-scanner#scan" hidden>Scanner</button>
            <video class="scan-video" data-scanner-target="video" hidden playsinline muted></video>
            <p class="scan-status" role="status" data-scanner-target="status"></p>
        </div>
    </form>

    {% if unknown %}
        <p><a href="{{ path('catalogue_product_index', {q: code}) }}">Chercher dans le catalogue</a></p>
    {% endif %}
{% endblock %}
