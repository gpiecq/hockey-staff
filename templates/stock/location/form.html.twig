{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
        <div class="field">
            {{ form_label(form.name) }}
            {{ form_widget(form.name) }}
            {% for error in form.name.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
        </div>

        <div class="field">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {% for error in form.description.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
        </div>

        <div class="field">
            {{ form_widget(form.active) }} {{ form_label(form.active) }}
            {% for error in form.active.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
        </div>

        {% for error in form.vars.errors %}<p class="form-error">{{ error.message }}</p>{% endfor %}

        <div class="actions">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn" href="{{ path('stock_location_index') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
