{# Champ « état » en tuiles ; les états sans stock (disabled) restent visibles, grisés. #}
<fieldset class="field">
    <legend>{{ field.vars.label }}</legend>
    <div class="tiles">
        {% for choice in field %}
            <label class="tile">{{ form_widget(choice) }}<span>{{ choice.vars.label }}</span></label>
        {% endfor %}
    </div>
    {% for error in field.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
</fieldset>
