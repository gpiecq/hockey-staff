{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <h1>{{ title }}</h1>

    {% if form is null %}
        <p class="empty">Créez d'abord un lieu.</p>
        {% if is_granted('LOCATION_MANAGE') %}
            <a class="btn btn-primary" href="{{ path('stock_location_new') }}">Nouveau lieu</a>
        {% endif %}
    {% else %}
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {% for error in form.vars.errors %}<p class="form-error" role="alert">{{ error.message }}</p>{% endfor %}

            <div class="field">
                {{ form_label(form.location) }}
                {{ form_widget(form.location) }}
                {% for error in form.location.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
            </div>
            <div class="field">
                {{ form_label(form.documentReference) }}
                {{ form_widget(form.documentReference) }}
            </div>
            <div class="field">
                {{ form_label(form.comment) }}
                {{ form_widget(form.comment) }}
            </div>

            <div data-controller="form-collection" data-form-collection-index-value="{{ form.lines|length }}">
                {% for error in form.lines.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
                <div class="entry-lines" data-form-collection-target="list" data-prototype="{{ include('stock/entry/_line.html.twig', {line: form.lines.vars.prototype})|e('html_attr') }}">
                    {% for line in form.lines %}
                        {{ include('stock/entry/_line.html.twig', {line: line}) }}
                    {% endfor %}
                </div>
                <button type="button" class="btn" data-action="form-collection#add">Ajouter une ligne</button>
            </div>

            {{ form_rest(form) }}

            <div class="actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a class="btn" href="{{ path('app_dashboard') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    {% endif %}
{% endblock %}
