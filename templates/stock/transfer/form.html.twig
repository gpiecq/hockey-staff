{% extends 'base.html.twig' %}

{% block title %}Transfert de stock{% endblock %}

{% block body %}
    <h1>Transfert de stock</h1>

    {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
        {% for error in form.vars.errors %}<p class="form-error" role="alert">{{ error.message }}</p>{% endfor %}

        <div class="field">
            {{ form_label(form.from) }}
            {{ form_widget(form.from) }}
            {% for error in form.from.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
        </div>
        <div class="field">
            {{ form_label(form.to) }}
            {{ form_widget(form.to) }}
            {% for error in form.to.vars.errors %}<p class="field-error">{{ error.message }}</p>{% endfor %}
        </div>
        <div class="field">
            {{ form_label(form.comment) }}
            {{ form_widget(form.comment) }}
        </div>

        {{ include('stock/_operation_lines.html.twig') }}

        {{ form_rest(form) }}

        <div class="actions">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn" href="{{ path('app_dashboard') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
