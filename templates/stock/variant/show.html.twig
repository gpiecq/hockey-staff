{% extends 'base.html.twig' %}

{% block title %}{{ product.designation }} · {{ variant.label ?: 'Unique' }}{% endblock %}

{% block body %}
    {% set equipment = product.kind.value == 'equipment' %}
    <a class="back" href="{{ path('stock_index') }}">‹ Stock</a>
    <div class="page-head">
        <h1>{{ product.designation }}</h1>
    </div>
    <p><strong>{{ variant.label ?: 'Unique' }}</strong>
        {% if variant.archived %}<span class="badge badge-warn">Archivée</span>{% elseif not variant.active %}<span class="badge badge-warn">Plus au catalogue</span>{% endif %}</p>

    <dl class="product-meta">
        <dt>Référence</dt><dd><a href="{{ path('catalogue_product_show', {id: product.id}) }}">{{ product.reference }}</a></dd>
        <dt>EAN</dt><dd>{{ variant.ean ?? '—' }}</dd>
        <dt>Code</dt><dd>{{ variant.code }}</dd>
        <dt>Type</dt><dd>{{ product.kind.label }}</dd>
        {% if price %}
            <dt>Prix club{% if season %} {{ season.label }}{% endif %}</dt><dd>{{ price.clubPriceTtc is null ? '—' : price.clubPriceTtc|euros ~ ' TTC' }}</dd>
            <dt>Prix public</dt><dd>{{ price.publicPriceTtc is null ? '—' : price.publicPriceTtc|euros ~ ' TTC' }}</dd>
        {% else %}
            <dt>Tarif</dt><dd class="muted">Tarif absent</dd>
        {% endif %}
    </dl>

    {% set inStock = locations is not empty %}
    {% set canMove = is_granted('STOCK_MOVE') and inStock %}
    {% set canLoan = equipment and canMove %}
    {% set canReturn = is_granted('STOCK_MOVE') and holders is not empty %}
    {% set canSell = equipment and secondHand is not empty and is_granted('SALE_MANAGE') %}
    {% if canLoan or canReturn or canMove or canSell %}
        <div class="actions variant-actions">
            {% if canLoan %}<a class="btn btn-primary" href="{{ path('stock_loan_new', {id: variant.id}) }}">Prêter</a>{% endif %}
            {% if canReturn %}<a class="btn" href="{{ path('stock_loan_return', {id: variant.id}) }}">Retour</a>{% endif %}
            {% if canMove %}
                <a class="btn" href="{{ path('stock_gift_new', {id: variant.id}) }}">Donner</a>
                <a class="btn" href="{{ path('stock_out_new', {variant: variant.id}) }}">Sortie</a>
            {% endif %}
            {% if canSell %}<a class="btn" href="{{ path('sale_new', {variant: variant.id}) }}">Vendre</a>{% endif %}
        </div>
    {% endif %}

    <h2>Stock par lieu</h2>
    {% if locations is empty %}
        <p class="empty">Aucun article en stock.</p>
    {% else %}
        <ul class="plain-list">
            {% for name, data in locations %}
                <li><strong>{{ name }}</strong> :
                    {% if equipment %}
                        {% for label, n in data.conditions %}{{ label }} {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}
                    {% else %}
                        {{ data.quantity }}
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% if equipment and secondHand is not empty and is_granted('SALE_MANAGE') %}
        <h2>Occasion en stock</h2>
        <table class="table second-hand">
            <thead><tr><th>Lieu</th><th>État</th><th class="num">Quantité</th><th></th></tr></thead>
            <tbody>
                {% for level in secondHand %}
                    <tr>
                        <td data-label="Lieu">{{ level.location.name }}</td>
                        <td data-label="État">{{ level.condition.label }}</td>
                        <td class="num" data-label="Quantité">{{ level.quantity }}</td>
                        <td><a href="{{ path('sale_new', {variant: variant.id, etat: level.condition.value, lieu: level.location.id}) }}">Vendre</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% if equipment or holders is not empty %}
        <h2>Détenteurs</h2>
        {% if holders is empty %}
            <p class="empty">Aucun joueur ne détient cet article.</p>
        {% else %}
            <table class="table holders">
                <thead><tr><th>Joueur</th><th class="num">Quantité</th><th></th></tr></thead>
                <tbody>
                    {% for holding in holders %}
                        <tr>
                            <td data-label="Joueur">{{ include('player/_link.html.twig', {player: holding.player}) }}</td>
                            <td class="num" data-label="Quantité">{{ holding.quantity }}</td>
                            <td>{% if is_granted('STOCK_MOVE') %}<a href="{{ path('stock_loan_return', {id: variant.id, joueur: holding.player.id}) }}">Retour</a>{% endif %}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endif %}
{% endblock %}
