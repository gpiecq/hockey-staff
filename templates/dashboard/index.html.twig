{% extends 'base.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block body %}
    <h1>Tableau de bord</h1>
    <p class="lead">Bienvenue, {{ app.user.firstName }}.</p>

    <div class="stats">
        <div class="stat" data-stat="season">
            <span class="stat-label">Saison courante</span>
            <span class="stat-value">{{ season ? season.label : 'Aucune saison courante' }}</span>
        </div>
        <div class="stat" data-stat="products">
            <span class="stat-label">Produits</span>
            <span class="stat-value">{{ productCount }}</span>
        </div>
        <div class="stat" data-stat="variants">
            <span class="stat-label">Variantes actives</span>
            <span class="stat-value">{{ variantCount }}</span>
        </div>
        {% if missingPriceCount is not null %}
            <div class="stat" data-stat="missing-price">
                <span class="stat-label">Produits sans tarif</span>
                {% if missingPriceCount > 0 %}
                    <a class="stat-value" href="{{ path('catalogue_product_index', {sansTarif: 1}) }}">{{ missingPriceCount }}</a>
                {% else %}
                    <span class="stat-value">Aucun</span>
                {% endif %}
            </div>
        {% endif %}
        {% if missingCategoryCount is not null %}
            <div class="stat" data-stat="missing-category">
                <span class="stat-label">Produits sans catégorie</span>
                {% if missingCategoryCount > 0 %}
                    <a class="stat-value" href="{{ path('catalogue_product_index', {sansCategorie: 1}) }}">{{ missingCategoryCount }}</a>
                {% else %}
                    <span class="stat-value">Aucun</span>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {% if canImport %}
        <section class="panel" id="dernier-import">
            <h2>Dernier import</h2>
            {% if lastImport %}
                <p>
                    <a href="{{ path('import_show', {id: lastImport.id}) }}">{{ lastImport.supplier.name }} · {{ lastImport.season.label }}</a>
                    · <span class="badge{{ lastImport.status.value in ['applied', 'analyzed'] ? ' badge-strong' : (lastImport.status.value == 'failed' ? ' badge-warn' : '') }}">{{ lastImport.status.label }}</span>
                    · {{ lastImport.createdAt ? lastImport.createdAt|date('d/m/Y H:i') : '—' }}
                </p>
            {% else %}
                <p class="empty">Aucun import pour le moment.</p>
            {% endif %}
            <p><a href="{{ path('import_prepare') }}">Préparer un import</a> avec une IA à partir des fichiers du fournisseur.</p>
        </section>
    {% endif %}

    <div class="actions shortcuts">
        <a class="btn btn-primary" href="{{ path('catalogue_product_index') }}">Rechercher un produit</a>
        {% if canImport %}<a class="btn" href="{{ path('import_new') }}">Nouvel import</a>{% endif %}
    </div>
{% endblock %}
