{% extends 'base.html.twig' %}

{% block title %}Prêts en cours{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>Prêts en cours</h1>
    </div>

    <form method="get" class="filters" role="search">
        <select name="equipe" aria-label="Équipe">
            <option value="">Toutes les équipes</option>
            {% for t in teams %}<option value="{{ t.id }}"{% if team and t.id == team.id %} selected{% endif %}>{{ t.name }}</option>{% endfor %}
        </select>
        <select name="saison" aria-label="Saison">
            <option value="">Toutes les saisons</option>
            {% for s in seasons %}<option value="{{ s.id }}"{% if season and s.id == season.id %} selected{% endif %}>{{ s.label }}</option>{% endfor %}
        </select>
        <button type="submit" class="btn">Filtrer</button>
    </form>

    {% if page.items is empty %}
        <p class="empty">Aucun prêt en cours.</p>
    {% else %}
        <table class="table">
            <thead>
                <tr><th>Joueur</th><th>Article</th><th class="num">Quantité</th><th>Depuis le</th></tr>
            </thead>
            <tbody>
                {% for holding in page.items %}
                    <tr>
                        <td data-label="Joueur"><a href="{{ path('player_show', {id: holding.player.id}) }}">{{ holding.player.fullName }}</a></td>
                        <td data-label="Article"><a href="{{ path('stock_variant_show', {id: holding.variant.id}) }}">{{ holding.variant.product.designation }} · {{ holding.variant.label ?: 'Unique' }}</a></td>
                        <td class="num" data-label="Quantité">{{ holding.quantity }}</td>
                        <td data-label="Depuis le">{{ loanDates[holding.id] is defined ? loanDates[holding.id]|date('d/m/Y') : '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    {% include '_pagination.html.twig' with {page: page, noun: 'prêts'} %}
{% endblock %}
