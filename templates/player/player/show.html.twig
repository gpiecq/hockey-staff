{% extends 'base.html.twig' %}

{% block title %}{{ player.fullName }}{% endblock %}

{% block body %}
    <div class="page-head">
        <h1>{{ player.fullName }}</h1>
        {% if is_granted('PLAYER_MANAGE') %}
            <a class="btn" href="{{ path('player_edit', {id: player.id}) }}">Modifier</a>
        {% endif %}
    </div>

    <dl>
        <dt>Poste</dt>
        <dd>{{ player.position.label }}</dd>
        <dt>Notes</dt>
        <dd>{{ player.notes|default('—')|nl2br }}</dd>
    </dl>

    <h2>Effectifs</h2>
    {% if rosters is empty %}
        <p class="empty">Aucun effectif.</p>
    {% else %}
        <table class="table">
            <thead><tr><th>Équipe</th><th>Saison</th><th>N°</th></tr></thead>
            <tbody>
                {% for entry in rosters %}
                    <tr>
                        <td>{{ entry.teamSeason.team.name }}</td>
                        <td>{{ entry.teamSeason.season.label }}</td>
                        <td>{{ entry.number ?? '—' }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>Pièces détenues</h2>
    {% if held is empty %}
        <p class="empty">Aucune pièce prêtée.</p>
    {% else %}
        <table class="table">
            <thead><tr><th>Pièce</th><th>Variante</th><th>Prêtée le</th><th></th></tr></thead>
            <tbody>
                {% for item in held %}
                    <tr>
                        <td><a href="{{ path('stock_item_show', {code: item.code}) }}">{{ item.code }}</a></td>
                        <td>{{ item.variant.product.designation }} · {{ item.variant.label ?: 'Unique' }}</td>
                        <td>{{ loanDates[item.id] is defined ? loanDates[item.id]|date('d/m/Y') : '—' }}</td>
                        <td>
                            {% if is_granted('STOCK_MOVE') %}
                                <a class="btn" href="{{ path('stock_loan_return', {id: item.variant.id, item: item.code}) }}">Retour</a>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <h2>Historique</h2>
    {% if history is empty %}
        <p class="empty">Aucune opération.</p>
    {% else %}
        <table class="table">
            <thead><tr><th>Date</th><th>Opération</th></tr></thead>
            <tbody>
                {% for operation in history %}
                    <tr>
                        <td>{{ operation.occurredAt|date('d/m/Y H:i') }}</td>
                        <td><a href="{{ path('stock_operation_show', {id: operation.id}) }}">{{ operation.type.label }}</a></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p><a href="{{ path('player_index') }}">Retour aux joueurs</a></p>
{% endblock %}
